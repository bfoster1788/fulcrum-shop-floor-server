# Copy to .env and fill in before running in real mode.

# Generate this in Fulcrum: Settings -> API / Integrations -> Public API Token.
# One static company-wide token. Never share it or commit it.
FULCRUM_API_TOKEN=

# Fulcrum's Public API base URL (their subdomain, "speedmetal" per Brian's account, not the mcp path).
FULCRUM_API_BASE_URL=https://speedmetal.fulcrumpro.com/api

# When true, no real Fulcrum calls are made -- everything is served from local mock data,
# same convention as the design canvas's pwa/api.js MOCK flag. Flip to false once
# FULCRUM_API_TOKEN is set and you're ready to go live.
MOCK_MODE=true

# Port the server listens on.
PORT=3000

# Comma-separated list of origins allowed to call this API (the PWA's deployed origin,
# plus http://localhost:* during development). "*" is fine for initial testing only.
ALLOWED_ORIGINS=*

# Required to register/re-map an operator's badge (POST /api/operators). Pick any long random
# string (e.g. `openssl rand -hex 32`) and keep it private -- treat it like a password. Send it to
# the phone/computer doing badge registration as the X-Admin-Token header. Without this set, the
# server refuses all operator-registration requests (fails closed, not open).
ADMIN_TOKEN=
